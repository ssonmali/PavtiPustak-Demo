# @vercel/analytics declares optional peers for every framework it supports,
# SvelteKit among them. npm tries to resolve that peer even though nothing here
# uses Svelte, which drags in @sveltejs/vite-plugin-svelte, which requires
# vite 8 — while vitest requires vite 7. The install then fails with ERESOLVE on
# a conflict between two packages this project does not have.
#
# Set here rather than passed on the command line so a fresh checkout and the
# Vercel build resolve exactly the way this lockfile was produced. Verified
# after the fact: neither @sveltejs/kit nor vite 8 is in the tree.
legacy-peer-deps=true
