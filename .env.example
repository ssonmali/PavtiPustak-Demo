# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mandal branding used in the WhatsApp receipt message
NEXT_PUBLIC_MANDAL_NAME=श्री गणेश मित्र मंडळ

# Optional: faint watermark behind the individual receipt slip.
# Must be a path to a file in public/ (next/image would reject an outside URL
# unless its host is added to next.config remotePatterns). Unset = no watermark.
NEXT_PUBLIC_RECEIPT_WATERMARK=/idol.jpg

# Optional, but set these in production. They appear on the receipt the donor
# receives — the address line and the two signature lines on the shared image
# and the WhatsApp message. Each is omitted cleanly when unset, so forgetting
# them on the host does not break anything: it just sends donors a receipt with
# no address and no signatures, which is easy not to notice.
NEXT_PUBLIC_MANDAL_ADDRESS=मंडळाचा पत्ता
NEXT_PUBLIC_MANDAL_PRESIDENT=अध्यक्षांचे नाव
NEXT_PUBLIC_MANDAL_VICE_PRESIDENT=उपाध्यक्षांचे नाव

# Optional. Set on Vercel to lock /api/keepalive to the built-in Cron, which
# sends `Authorization: Bearer <CRON_SECRET>`. Left unset the route stays open
# so a free uptime monitor can call it too; it only runs `select now()`.
# CRON_SECRET=a-long-random-string
