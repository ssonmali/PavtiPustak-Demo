# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mandal branding used in the WhatsApp receipt message
NEXT_PUBLIC_MANDAL_NAME=श्री गणेश मित्र मंडळ

# Optional: faint watermark behind the individual receipt slip.
# Must be a path to a file in public/ (next/image would reject an outside URL
# unless its host is added to next.config remotePatterns). Unset = no watermark.
NEXT_PUBLIC_RECEIPT_WATERMARK=/idol.jpg
